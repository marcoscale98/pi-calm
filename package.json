{
  "name": "pi-calm",
  "version": "1.0.1",
  "description": "Make Pi easier to follow while it works: keep the conversation and Working... visible while quietly hiding tool chatter and optional thinking. Toggle it with /calm on, /calm thinking, and /calm off.",
  "author": "Marco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoscale98/pi-calm.git"
  },
  "homepage": "https://github.com/marcoscale98/pi-calm#readme",
  "bugs": {
    "url": "https://github.com/marcoscale98/pi-calm/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "calm",
    "tui"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/calm/index.ts"
    ]
  }
}
